# NextAuth
NEXTAUTH_SECRET=your_random_secret_here         # รัน: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000              # เปลี่ยนเป็น domain จริงตอน deploy

# Google OAuth (ได้จาก console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# TwelveData
NEXT_PUBLIC_TWELVEDATA_KEY=your_key

# Price Server (Railway URL)
NEXT_PUBLIC_PRICE_SERVER_URL=http://localhost:3002

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
