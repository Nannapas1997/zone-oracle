# ─── PRICE FEED ───────────────────────────────────────────────
# TwelveData — https://twelvedata.com (free tier: 800 req/day)
NEXT_PUBLIC_TWELVEDATA_KEY=your_twelvedata_api_key_here

# Finnhub fallback — https://finnhub.io (free tier: 60 req/min)
NEXT_PUBLIC_FINNHUB_KEY=your_finnhub_api_key_here

# ─── AUTH (Clerk) ─────────────────────────────────────────────
# https://clerk.com → Create app → copy keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── PAYMENTS (Stripe) ────────────────────────────────────────
# https://stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Stripe Price IDs — create in Stripe Dashboard → Products
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxxxxxx

# ─── APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Change to your domain in production:
# NEXT_PUBLIC_APP_URL=https://zone-oracle.com
